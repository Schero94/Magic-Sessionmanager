{
  "version": "4.12.0",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "strapi-v5",
    "strapi-5",
    "sessions",
    "session-management",
    "jwt",
    "refresh-token",
    "logout",
    "users-permissions",
    "geoip",
    "login-security"
  ],
  "type": "commonjs",
  "bin": {
    "strapi-magic-sessionmanager-geoip": "scripts/update-geoip-db.mjs"
  },
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.js",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "source": "./server/src/index.js",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "strapi-admin.js",
    "strapi-server.js",
    "scripts/geoip-updater.cjs",
    "scripts/update-geoip-db.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "pics"
  ],
  "engines": {
    "node": "^22.22.2 || >=24.15.0",
    "npm": ">=6.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "node --test tests/*.test.js tests/*.test.mjs",
    "test:concurrency": "node scripts/concurrency/run.mjs",
    "test:ts:front": "tsc --noEmit --allowJs --jsx react-jsx --moduleResolution bundler --module esnext -p admin/jsconfig.json",
    "test:ts:back": "tsc --noEmit --allowJs --moduleResolution node --module commonjs -p server/jsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run clean && strapi-plugin build && node scripts/build-server-bundle.mjs",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "geoip:update": "node scripts/update-geoip-db.mjs",
    "verify": "strapi-plugin verify",
    "verify:runtime": "node scripts/verify-server-bundle.mjs",
    "prepublishOnly": "npm test && npm run build && npm run verify && npm run verify:runtime"
  },
  "dependencies": {
    "@maxmind/geoip2-node": "^7.1.0",
    "@strapi/utils": "^5.0.0",
    "sanitize-html": "^2.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "5.61.0",
    "better-sqlite3": "^13.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-router-dom": "^6.30.6",
    "semantic-release": "^25.0.9",
    "styled-components": "^6.6.0"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/plugin-users-permissions": "^5.0.0",
    "@strapi/strapi": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-intl": "^6.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@strapi/design-system": {
      "optional": true
    },
    "@strapi/icons": {
      "optional": true
    },
    "react-intl": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "strapi": {
    "kind": "plugin",
    "name": "magic-sessionmanager",
    "displayName": "Magic Sessionmanager",
    "description": "Track, revoke and limit Users & Permissions login sessions, with online status, analytics and optional GeoIP checks."
  },
  "name": "strapi-plugin-magic-sessionmanager",
  "description": "Session tracking and control for Strapi 5 Users & Permissions logins: see who is online, revoke sessions, block users, rate-limit failed logins and add optional GeoIP checks.",
  "license": "MIT",
  "author": "Schero D.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Schero94/Magic-Sessionmanager.git"
  },
  "bugs": {
    "url": "https://github.com/Schero94/Magic-Sessionmanager/issues"
  },
  "homepage": "https://schero94.github.io/Magic-Sessionmanager/",
  "private": false
}
